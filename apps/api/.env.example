NODE_ENV=development
PORT=3333
DATABASE_URL=
JWT_SECRET=
PLATFORM_FEE_PERCENT=10

# Links públicos (painel, overlay e a própria API)
PUBLIC_API_URL=http://localhost:3333
PUBLIC_WEB_URL=http://localhost:5173
# PUBLIC_OVERLAY_URL=  (por omissão igual a PUBLIC_WEB_URL: os widgets abrem no próprio site)

# Demonstração e sandbox: streamer kiami@fedha.test / fedha2026; MCX confirma sozinho ao fim de 5 s
SEED_DEMO=true
SANDBOX_AUTO_CONFIRM_MS=5000

# Mensagens (RN-CON-02 códigos, RF-DOA-13 recibos, RF-OPE-08 notificações). Segredos só no .env, nunca no git.
# Teste: pnpm --filter @fedha/api messaging check   |   messaging sms 9XXXXXXXX
# SMS: console (só log) | ombala (https://useombala.ao) | http (outro gateway: POST {to, from, text} com Bearer)
SMS_PROVIDER=console
# Remetente aprovado na Ombala (até 11 caracteres)
SMS_SENDER=FEDHA
# OMBALA_API_URL=https://api.useombala.ao
# OMBALA_API_TOKEN=
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN=

# WhatsApp: console | evolution (Evolution API self-hosted, ver infra/evolution) | meta (WhatsApp Cloud API)
WHATSAPP_PROVIDER=console
# EVOLUTION_API_URL=http://localhost:8081
# EVOLUTION_API_KEY=   (igual a AUTHENTICATION_API_KEY do docker-compose da Evolution)
# EVOLUTION_INSTANCE=fedha
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# Email: console | resend
EMAIL_PROVIDER=console
# RESEND_API_KEY=
